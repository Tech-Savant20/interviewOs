# Copy to Backend/.env for local development: cp .env.example .env
NODE_ENV=development
PORT=5000

# Frontend dev server (CORS + links in emails / meeting invites)
CLIENT_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=interviewos
DB_NAME=interviewos
DB_SSL=false

# Redis (matches docker-compose.yml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string

# Store resumes in Backend/uploads instead of S3
RESUME_STORAGE=local
# S3 (production): remove RESUME_STORAGE=local and set these
# S3_BUCKET_NAME=
# AWS_REGION=ap-south-1

# AI mock interview (https://console.groq.com)
GROQ_API_KEY=

# Code execution: RapidAPI key for Judge0 CE.
# Without a key, set JUDGE0_API_URL=https://ce.judge0.com (free public instance, rate limited)
JUDGE0_API_KEY=
JUDGE0_API_URL=https://ce.judge0.com

# Email via Brevo (optional locally — the signup OTP is also printed in the backend console)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
